{
  "manifest_version": 3,
  "name": "图片下载器",
  "version": "1.0.0",
  "description": "用于下载Hellorf网站图片的浏览器扩展 - 内嵌版",
  "author": "开发者",
  
  "icons": {
    "16": "image/icon16.png",
    "48": "image/icon48.png",
    "128": "image/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "image/icon16.png",
      "32": "image/icon48.png"
    },
    "default_title": "图片下载器"
  },

  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://plus.hellorf.com/*",
    "https://www.shutterstock.com/*",
    "http://test.xztimes.cn/",
    "http://117.24.14.3:1012/"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://plus.hellorf.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://www.shutterstock.com/*"],
      "js": ["content-shutterstock.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["iframe.html", "iframe.js", "image/*.png"],
      "matches": ["https://plus.hellorf.com/*", "https://www.shutterstock.com/*"]
    }
  ]
}